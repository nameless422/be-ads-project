# Copy these exports into a local shell session and replace the placeholder values.
# Do not commit real secrets.
# Refresh token can be generated with:
#   BE_GOOGLE_ADS_CLIENT_ID=... BE_GOOGLE_ADS_CLIENT_SECRET=... go run ./cmd/google_oauth_bootstrap

export BE_GOOGLE_ADS_MODE=real
export BE_GOOGLE_ADS_DEVELOPER_TOKEN=replace_with_developer_token
export BE_GOOGLE_ADS_LOGIN_CUSTOMER_ID=3575940005
export BE_GOOGLE_ADS_CLIENT_ID=replace_with_client_id
export BE_GOOGLE_ADS_CLIENT_SECRET=replace_with_client_secret
export BE_GOOGLE_ADS_REFRESH_TOKEN=replace_with_refresh_token
export BE_GOOGLE_ADS_API_VERSION=v20
